#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#include "zmk-helpers/helper.h"

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// From Urob's Config
#include "zmk-helper-sofle.h"
#define KEYS_L LN0 LN1 LN2 LN3 LN4 LN5 LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  
#define KEYS_R RN0 RN1 RN2 RN3 RN4 RN5 RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5 
#define THUMBS LH0 LH1 LH2 LH3 LH4 RH0 RH1 RH2 RH3 RH4

#define QUICK_TAP_MS 175

&sk {
  release-after-ms = <900>;
  quick-release;
};

&sl { // Allow sticky mods to chord across sticky layers.
  ignore-modifiers;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                 \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";            \
               tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;         \
               require-prior-idle-ms = <150>; hold-trigger-on-release;         \
               hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

// Hack: Make HRM combos tap-only (cf, ZMK issue #544).
#define ZMK_COMBO_8(NAME, TAP, POS, LAYERS, COMBO_MS, IDLE_MS, HOLD, SIDE)     \
  MAKE_HRM(hm_combo_##NAME, &kp, TAP, SIDE THUMBS)                             \
  ZMK_COMBO_6(NAME, &hm_combo_##NAME HOLD 0, POS, LAYERS, COMBO_MS, IDLE_MS)

/* Combos, leader key sequences, mouse emulation */

#include "combos.dtsi" // Must be sourced after HRM-combo hack.


/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        // /* Left-hand HRMs. */
        // hml: hml {
        //     compatible = "zmk,behavior-hold-tap";
        //     #binding-cells = <2>;
        //     flavor = "balanced";
        //     tapping-term-ms = <280>;
        //     quick-tap-ms = <175>;
        //     require-prior-idle-ms = <150>;
        //     bindings = <&kp>, <&kp>;
        //     hold-trigger-key-positions = <KEYS_R THUMBS>;
        //     hold-trigger-on-release;
        // };
        // /* Right-hand HRMs. */
        // hmr: hmr {
        //     compatible = "zmk,behavior-hold-tap";
        //     #binding-cells = <2>;
        //     flavor = "balanced";
        //     tapping-term-ms = <280>;
        //     quick-tap-ms = <175>;
        //     require-prior-idle-ms = <150>;
        //     bindings = <&kp>, <&kp>;
        //     hold-trigger-key-positions = <KEYS_L THUMBS>;
        //     hold-trigger-on-release;
        // };
    };

    combos {
        compatible = "zmk,combos";

//        softoff {
//            bindings = <&soft_off>;
//            key-positions = <14 28 40>; // Row 1 Col 1, Row 2 Col 2, Row 3 Col 1
//        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */

/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */

/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */

/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */

/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */

/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */

        base {
            bindings = <
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */
    &none         &kp EXCL      &kp AT        &kp POUND     &kp DLLR      &kp PRCNT                   &kp UP_ARROW                   &kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR      &none        
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &kp Q         &kp W         &kp E         &kp R         &kp T                       &kp DOWN_ARROW                 &kp Y         &kp U         &kp I         &kp O         &kp P         &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &hml LCMD A   &hml LALT S   &hml LCTRL D  &hml LSHFT F  &kp G                       &kp LEFT_ARROW                 &kp H         &hmr LSHFT J  &hmr LCTRL K  &hmr LALT L   &hmr LCMD SQT &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &kp Z         &kp X         &kp C         &kp V         &kp B                       &kp RIGHT_ARROW                &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &none    
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */
    &kp C_MUTE                  &none         &none         &lt 3 ESC     &lt 1 TAB     &lt 2 SPACE   &kp ENTER        &lt 5 BSPC    &lt 4 MINUS   &lt 6 DEL     &none         &none     
/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "BASE";
        };

        navigation {
            bindings = <
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */
    &none         &none         &none         &none         &none         &none                       &kp UP_ARROW                   &none         &none         &none         &none         &none         &none        
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &kp DOWN_ARROW                 &kp K_REDO    &kp K_PASTE   &kp K_COPY    &kp K_CUT     &kp K_UNDO    &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &kp LEFT_ARROW                 &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp CAPS      &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &kp RIGHT_ARROW                &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &kp INSERT    &none    
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */
    &kp C_MUTE                  &none         &none         &none         &none         &none         &kp ENTER        &kp ENTER     &kp BSPC      &kp DEL       &none         &none     
/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */
            >;

            display-name = "NAV";
            sensor-bindings = <&scroll_encoder>;
        };

        mouse {
            bindings = <
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */
    &none         &none         &none         &none         &none         &none                       &mmv MOVE_UP                   &none          &none          &none        &none           &none      &none        
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &mmv MOVE_DOWN                 &kp K_REDO     &kp K_PASTE    &kp K_COPY   &kp K_CUT       &kp K_UNDO &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &mmv MOVE_LEFT                 &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none      &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &mmv MOVE_RIGHT                &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none      &none    
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */
    &kp C_MUTE                  &none         &none         &none         &none         &none         &mkp LCLK        &mkp LCLK     &mkp RCLK      &mkp MCLK      &mkp MB4     &mkp MB5  
/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */
            >;

            display-name = "MOUSE";
            sensor-bindings = <&scroll_encoder>;
        };

        media {
            bindings = <
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */
    &none         &none         &none         &none         &none         &none                       &kp UP_ARROW                   &none         &none             &none           &none         &none         &none        
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &kp DOWN_ARROW                 &none         &none             &none           &none         &none         &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &kp LEFT_ARROW                 &kp C_PREV    &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp C_NEXT    &none         &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none         &none         &none         &none         &none         &none                       &kp RIGHT_ARROW                &out OUT_TOG  &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */
    &kp C_MUTE                  &none         &none         &none         &none         &none         &kp ENTER        &kp C_STOP    &kp C_PP      &kp C_MUTE        &none           &none     
/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */
            >;

            display-name = "MEDIA";
            sensor-bindings = <&scroll_encoder>;
        };

        number {
            bindings = <
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */
    &none       &none       &none      &none         &none         &none       &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none       &kp LBKT    &kp N7     &kp N8        &kp N9        &kp RBKT    &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none       &kp SEMI    &kp N4     &kp N5        &kp N6        &kp EQUAL   &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
    &none       &kp GRAVE   &kp N1     &kp N2        &kp N3        &kp BSLH    &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */
    &kp C_MUTE  &none       &none      &kp MINUS     &kp N0        &kp DOT     &kp ENTER        &none      &none      &none      &none            &none     
/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */
            >;

            display-name = "NUM";
            sensor-bindings = <&scroll_encoder>;
        };

        symbols {
            bindings = <
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */
&none      &none       &none      &none         &none         &none      &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&none      &kp LBRC    &kp AMPS   &kp ASTRK     &kp LPAR      &kp RBRC   &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&none      &kp COLON   &kp DLLR   &kp PRCNT     &kp CARET     &kp PLUS   &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&none      &kp TILDE   &kp EXCL   &kp AT        &kp POUND     &kp PIPE   &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */
&kp C_MUTE &none       &none      &kp LPAR      &kp RPAR      &kp UNDER  &kp ENTER        &none      &none      &none      &none            &none     
/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */
            >;

            display-name = "SYM";
            sensor-bindings = <&scroll_encoder>;
        };

        function {
            bindings = <
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */
&none       &none      &none         &none         &none    &none        &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&none       &none      &kp F7        &kp F8        &kp F9   &kp F10      &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&none       &none      &kp F4        &kp F5        &kp F6   &kp F11      &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&none       &none      &kp F1        &kp F2        &kp F3   &kp F12      &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */
&kp C_MUTE  &none      &none         &none         &none    &none        &kp ENTER        &none      &none      &none      &none            &none     
/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */
            >;

            display-name = "FUNC";
            sensor-bindings = <&scroll_encoder>;
        };

        gaming {
            bindings = <
/*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮              ╭─────up──────╮               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ */
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────down─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BSLH
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────left─────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&kp LCTRL   &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp APOS
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤              ├────right────┤               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ */
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp ENTER
/*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╮├─────tap─────┤ ╭─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯ */
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &none   &kp SPACE    &kp ENTER        &kp BSPC   &none      &none      &kp RIGHT_SHIFT  &kp DELETE
/*╰─────────────╯             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯╰─────────────╯ ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯ */
            >;

            display-name = "GAME";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_8 {
            bindings = <
&none       &none      &none         &none         &none    &none        &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none       &none      &none         &none         &none    &none        &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &none         &none         &none    &none        &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &none         &none         &none    &none        &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE  &none      &none         &none         &none    &none        &kp ENTER        &none      &none      &none      &none            &none     
            >;

            display-name = "layer8";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_9 {
            bindings = <
&none       &none      &none         &none         &none    &none        &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none       &none      &none         &none         &none    &none        &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &none         &none         &none    &none        &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &none         &none         &none    &none        &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE  &none      &none         &none         &none    &none        &kp ENTER        &none      &none      &none      &none            &none     
            >;

            display-name = "layer9";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_10 {
            bindings = <
&none       &none      &none         &none         &none    &none        &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none       &none      &none         &none         &none    &none        &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &none         &none         &none    &none        &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &none         &none         &none    &none        &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE  &none      &none         &none         &none    &none        &kp ENTER        &none      &none      &none      &none            &none     
            >;

