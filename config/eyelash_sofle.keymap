#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#include "zmk-helpers/helper.h"

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// From Urob's Config
#include "zmk-helper-sofle.h"
#include "sofle-helpers.h"
#define KEYS_L LN_ROW LT_ROW LM_ROW LB_ROW 
#define KEYS_R RN_ROW RT_ROW RM_ROW RB_ROW 
#define THUMBS LH_ROW RH_ROW

#define QUICK_TAP_MS 175

&sk {
  release-after-ms = <900>;
  quick-release;
};

&sl { // Allow sticky mods to chord across sticky layers.
  ignore-modifiers;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        /* Left-hand HRMs. */
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        /* Right-hand HRMs. */
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";
        copy {
            bindings = <&kp LC(C)>;
            key-positions = <LM2 LB2>;
            timeout-ms = <50>;
        };
        paste {
            bindings = <&kp LS(INS)>;
            key-positions = <LM1 LB1>;
            timeout-ms = <50>;
        };
        exclamation_sym {
            bindings = <&kp EXCL>;
            key-positions = <LT4 LM4>;
            timeout-ms = <50>;
        };
        at_sym {
            bindings = <&kp AT>;
            key-positions = <LT3 LM3>;
            timeout-ms = <50>;
        };
        hash_sym {
            bindings = <&kp POUND>;
            key-positions = <LT2 LM2>;
            timeout-ms = <50>;
        };
        dollar_sym {
            bindings = <&kp DLLR>;
            key-positions = <LT1 LM1>;
            timeout-ms = <50>;
        };
        percent_sym {
            bindings = <&kp PRCNT>;
            key-positions = <LT0 LM0>;
            timeout-ms = <50>;
        };
        hat_sym {
            bindings = <&kp CARET>;
            key-positions = <RT0 RM0>;
            timeout-ms = <50>;
        };
        plus_sym {
            bindings = <&kp PLUS>;
            key-positions = <RT1 RM1>;
            timeout-ms = <50>;
        };
        star_sym {
            bindings = <&kp ASTRK>;
            key-positions = <RT2 RM2>;
            timeout-ms = <50>;
        };
        ampersand_sym {
            bindings = <&kp AMPS>;
            key-positions = <RT3 RM3>;
            timeout-ms = <50>;
        };
        underscore_sym {
            bindings = <&kp UNDER>;
            key-positions = <RM0 RB0>;
            timeout-ms = <50>;
        };
        left_paren_sym {
            bindings = <&kp LPAR>;
            key-positions = <RM1 RM2>;
            timeout-ms = <50>;
        };
        right_paren_sym {
            bindings = <&kp RPAR>;
            key-positions = <RM2 RM3>;
            timeout-ms = <50>;
        };
        left_bracket_sym {
            bindings = <&kp LBKT>;
            key-positions = <RB1 RB2>;
            timeout-ms = <50>;
        };
        right_bracket_sym {
            bindings = <&kp RBKT>;
            key-positions = <RB2 RB3>;
            timeout-ms = <50>;
        };
        left_brace_sym {
            bindings = <&kp LBRC>;
            key-positions = <RT1 RT2>;
            timeout-ms = <50>;
        };
        right_brace_sym {
            bindings = <&kp RBRC>;
            key-positions = <RT2 RT3>;
            timeout-ms = <50>;
        };
        backslash_sym {
            bindings = <&kp BSLH>;
            key-positions = <RM2 RB2>;
            timeout-ms = <50>;
        };
        pipe_sym {
            bindings = <&kp PIPE>;
            key-positions = <RM3 RB3>;
            timeout-ms = <50>;
        };
        colon_sym {
            bindings = <&kp COLON>;
            key-positions = <RM1 RB1>;
            timeout-ms = <50>;
        };
        // softoff {
        //     bindings = <&soft_off>;
        //     key-positions = <LT4 LM3 LB4>; // Row 1 Col 1, Row 2 Col 2, Row 3 Col 1
        // };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
&none         &kp EXCL      &kp AT        &kp POUND     &kp DLLR      &kp PRCNT                   &kp UP_ARROW                   &kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR      &none        
&none         &kp Q         &kp W         &kp E         &kp R         &kp T                       &kp DOWN_ARROW                 &kp Y         &kp U         &kp I         &kp O         &kp P         &none   
&none         &hml LCMD A   &hml LALT S   &hml LCTRL D  &hml LSHFT F  &kp G                       &kp LEFT_ARROW                 &kp H         &hmr LSHFT J  &hmr LCTRL K  &hmr LALT L   &hmr LCMD SQT &none   
&none         &kp Z         &kp X         &kp C         &kp V         &kp B                       &kp RIGHT_ARROW                &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &none    
&kp C_MUTE                  &none         &none         &lt 3 ESC     &lt 1 TAB     &lt 2 SPACE   &kp ENTER        &lt 5 BSPC    &lt 4 MINUS   &lt 6 DEL     &none         &none     
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "BASE";
        };

        navigation {
            bindings = <
&none         &none         &none         &none         &none         &none                       &kp UP_ARROW                   &none         &none         &none         &none         &none         &none        
&none         &kp LA(LS(SPC)) &kp LA(1)   &kp LA(2)     &kp LA(3)      &kp LA(4)                  &kp DOWN_ARROW                 &kp K_REDO    &kp LS(INSERT) &kp LC(C)     &kp K_CUT     &kp K_UNDO    &none   
&none         &kp LA(F4)     &kp LA(5)    &kp LA(6)     &kp LA(7)      &kp LA(8)                  &kp LEFT_ARROW                 &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp CAPS      &none   
&kp LSHIFT    &none         &kp LG(V)     &kp LG(GRAVE) &none         &none                       &kp RIGHT_ARROW                &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &kp INSERT    &none    
&kp C_MUTE                  &none         &none         &none         &none         &none         &kp ENTER        &kp ENTER     &kp BSPC      &kp DEL       &none         &none     
            >;

            display-name = "NAV";
            sensor-bindings = <&scroll_encoder>;
        };

        mouse {
            bindings = <
&none         &none         &none         &none         &none         &none                       &mmv MOVE_UP                   &none          &none          &none        &none           &none      &none        
&none         &none         &none         &none         &none         &none                       &mmv MOVE_DOWN                 &kp K_REDO     &kp K_PASTE    &kp K_COPY   &kp K_CUT       &kp K_UNDO &none   
&none         &none         &none         &none         &none         &none                       &mmv MOVE_LEFT                 &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none      &none   
&none         &none         &none         &none         &none         &none                       &mmv MOVE_RIGHT                &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none      &none    
&kp C_MUTE                  &none         &none         &none         &none         &none         &mkp LCLK        &mkp LCLK     &mkp RCLK      &mkp MCLK      &mkp MB4     &mkp MB5  
            >;

            display-name = "MOUSE";
            sensor-bindings = <&scroll_encoder>;
        };

        media {
            bindings = <
&none         &none         &none         &none         &none         &none                       &kp UP_ARROW                   &none         &none             &none           &none         &none         &none        
&none         &none         &none         &none         &none         &none                       &kp DOWN_ARROW                 &none         &none             &none           &none         &none         &none   
&none         &none         &none         &none         &none         &none                       &kp LEFT_ARROW                 &kp C_PREV    &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp C_NEXT    &none         &none   
&none         &none         &none         &none         &none         &none                       &kp RIGHT_ARROW                &out OUT_TOG  &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    
&kp C_MUTE                  &none         &none         &none         &none         &none         &kp ENTER        &kp C_STOP    &kp C_PP      &kp C_MUTE        &none           &none     
            >;

            display-name = "MEDIA";
            sensor-bindings = <&scroll_encoder>;
        };

        number {
            bindings = <
&none       &none       &none      &none         &none         &none       &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none       &kp LBKT    &kp N7     &kp N8        &kp N9        &kp RBKT    &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none       &kp SEMI    &kp N4     &kp N5        &kp N6        &kp EQUAL   &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none       &kp GRAVE   &kp N1     &kp N2        &kp N3        &kp BSLH    &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE  &none       &none      &kp MINUS     &kp N0        &kp DOT     &kp ENTER        &none      &none      &none      &none            &none     
            >;

            display-name = "NUM";
            sensor-bindings = <&scroll_encoder>;
        };

        symbols {
            bindings = <
&none      &none       &none      &none         &none         &none      &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none      &kp LBRC    &kp AMPS   &kp ASTRK     &kp LPAR      &kp RBRC   &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none      &kp COLON   &kp DLLR   &kp PRCNT     &kp CARET     &kp PLUS   &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none      &kp TILDE   &kp EXCL   &kp AT        &kp POUND     &kp PIPE   &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE &none       &none      &kp LPAR      &kp RPAR      &kp UNDER  &kp ENTER        &none      &none      &none      &none            &none     
            >;

            display-name = "SYM";
            sensor-bindings = <&scroll_encoder>;
        };

        function {
            bindings = <
&none       &none      &none         &none         &none    &none        &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none       &none      &kp F7        &kp F8        &kp F9   &kp F10      &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &kp F4        &kp F5        &kp F6   &kp F11      &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &kp F1        &kp F2        &kp F3   &kp F12      &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE  &none      &none         &none         &none    &none        &kp ENTER        &none      &none      &none      &none            &none     
            >;

            display-name = "FUNC";
            sensor-bindings = <&scroll_encoder>;
        };

        gaming {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BSLH
&kp LCTRL   &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp ENTER
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &none   &kp SPACE    &kp ENTER        &kp BSPC   &none      &none      &kp RIGHT_SHIFT  &kp DELETE
            >;

            display-name = "GAME";
            sensor-bindings = <&scroll_encoder>;
        };

        mac-base {
            bindings = <
&none         &kp EXCL      &kp AT        &kp POUND     &kp DLLR      &kp PRCNT                   &kp UP_ARROW                   &kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR      &none        
&none         &kp Q         &kp W         &kp E         &kp R         &kp T                       &kp DOWN_ARROW                 &kp Y         &kp U         &kp I         &kp O         &kp P         &none   
&none         &hml LCMD A   &hml LALT S   &hml LCTRL D  &hml LSHFT F  &kp G                       &kp LEFT_ARROW                 &kp H         &hmr LSHFT J  &hmr LCTRL K  &hmr LALT L   &hmr LCMD SQT &none   
&none         &kp Z         &kp X         &kp C         &kp V         &kp B                       &kp RIGHT_ARROW                &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &none    
&kp C_MUTE                  &none         &none         &lt 11 ESC     &lt 9 TAB     &lt 10 SPACE   &kp ENTER        &lt 13 BSPC    &lt 12 MINUS   &lt 14 DEL     &none         &none     
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "MAC_BASE";
        };

        mac-navigation {
            bindings = <
&none         &none         &none         &none         &none         &none                       &kp UP_ARROW                   &none         &none         &none         &none         &none         &none        
&none         &kp LA(LS(SPC)) &kp LA(1)   &kp LA(2)     &kp LA(3)      &kp LA(4)                  &kp DOWN_ARROW                 &kp K_REDO    &kp LS(INSERT) &kp LC(C)     &kp K_CUT     &kp K_UNDO    &none   
&none         &kp LA(F4)     &kp LA(5)    &kp LA(6)     &kp LA(7)      &kp LA(8)                  &kp LEFT_ARROW                 &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp CAPS      &none   
&kp LSHIFT    &none         &kp LG(V)     &kp LG(GRAVE) &none         &none                       &kp RIGHT_ARROW                &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &kp INSERT    &none    
&kp C_MUTE                  &none         &none         &none         &none         &none         &kp ENTER        &kp ENTER     &kp BSPC      &kp DEL       &none         &none     
            >;

            display-name = "MAC_NAV";
            sensor-bindings = <&scroll_encoder>;
        };

        mac-mouse {
            bindings = <
&none         &none         &none         &none         &none         &none                       &mmv MOVE_UP                   &none          &none          &none        &none           &none      &none        
&none         &none         &none         &none         &none         &none                       &mmv MOVE_DOWN                 &kp K_REDO     &kp K_PASTE    &kp K_COPY   &kp K_CUT       &kp K_UNDO &none   
&none         &none         &none         &none         &none         &none                       &mmv MOVE_LEFT                 &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none      &none   
&none         &none         &none         &none         &none         &none                       &mmv MOVE_RIGHT                &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none      &none    
&kp C_MUTE                  &none         &none         &none         &none         &none         &mkp LCLK        &mkp LCLK     &mkp RCLK      &mkp MCLK      &mkp MB4     &mkp MB5  
            >;

            display-name = "MAC_MOUSE";
            sensor-bindings = <&scroll_encoder>;
        };

        mac-media {
            bindings = <
&none         &none         &none         &none         &none         &none                       &kp UP_ARROW                   &none         &none             &none           &none         &none         &none        
&none         &none         &none         &none         &none         &none                       &kp DOWN_ARROW                 &none         &none             &none           &none         &none         &none   
&none         &none         &none         &none         &none         &none                       &kp LEFT_ARROW                 &kp C_PREV    &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp C_NEXT    &none         &none   
&none         &none         &none         &none         &none         &none                       &kp RIGHT_ARROW                &out OUT_TOG  &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    
&kp C_MUTE                  &none         &none         &none         &none         &none         &kp ENTER        &kp C_STOP    &kp C_PP      &kp C_MUTE        &none           &none     
            >;

            display-name = "MAC_MEDIA";
            sensor-bindings = <&scroll_encoder>;
        };

        mac-number {
            bindings = <
&none       &none       &none      &none         &none         &none       &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none       &kp LBKT    &kp N7     &kp N8        &kp N9        &kp RBKT    &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none       &kp SEMI    &kp N4     &kp N5        &kp N6        &kp EQUAL   &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none       &kp GRAVE   &kp N1     &kp N2        &kp N3        &kp BSLH    &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE  &none       &none      &kp MINUS     &kp N0        &kp DOT     &kp ENTER        &none      &none      &none      &none            &none     
            >;

            display-name = "MAC_NUM";
            sensor-bindings = <&scroll_encoder>;
        };

        mac-symbols {
            bindings = <
&none      &none       &none      &none         &none         &none      &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none      &kp LBRC    &kp AMPS   &kp ASTRK     &kp LPAR      &kp RBRC   &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none      &kp COLON   &kp DLLR   &kp PRCNT     &kp CARET     &kp PLUS   &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none      &kp TILDE   &kp EXCL   &kp AT        &kp POUND     &kp PIPE   &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE &none       &none      &kp LPAR      &kp RPAR      &kp UNDER  &kp ENTER        &none      &none      &none      &none            &none     
            >;

            display-name = "MAC_SYM";
            sensor-bindings = <&scroll_encoder>;
        };

        mac-function {
            bindings = <
&none       &none      &none         &none         &none    &none        &kp UP_ARROW     &none      &none      &none      &none            &none       &none        
&none       &none      &kp F7        &kp F8        &kp F9   &kp F10      &kp DOWN_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &kp F4        &kp F5        &kp F6   &kp F11      &kp LEFT_ARROW   &none      &none      &none      &none            &none       &none   
&none       &none      &kp F1        &kp F2        &kp F3   &kp F12      &kp RIGHT_ARROW  &none      &none      &none      &none            &none       &none    
&kp C_MUTE  &none      &none         &none         &none    &none        &kp ENTER        &none      &none      &none      &none            &none     
            >;

            display-name = "MAC";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};


